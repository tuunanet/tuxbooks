{
  "name": "tuxbooks",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first ebook library manager (bookshelf style) built with Electron + React + a Rust sidecar.",
  "homepage": "https://github.com/tuunanet/tuxbooks",
  "license": "GPL-3.0-or-later",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev:electron": "node scripts/build-electron.mjs && electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm --filter frontend build",
    "test": "pnpm --filter frontend test",
    "test:ci": "pnpm --filter frontend test:ci",
    "lint": "pnpm --filter frontend lint && tsc -p electron --noEmit",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typecheck:frontend": "tsc -p frontend --noEmit",
    "typecheck": "pnpm run typecheck:frontend && tsc -p electron --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "electron": "^44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "lint-staged": "^17.5.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.34.5",
  "desktopName": "tuxbooks.desktop"
}

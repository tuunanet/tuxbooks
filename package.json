    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter frontend typecheck"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@10.34.5"

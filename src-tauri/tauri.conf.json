{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuxbooks",
  "version": "0.2.0",
  "identifier": "com.tuxbooks.app",
  "build": {
    "beforeDevCommand": "pnpm --filter frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tuxbooks",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; frame-src 'self' blob:; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob:; media-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Reference",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

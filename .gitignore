# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# Rust
sidecar/target/
target/

# Databases / generated artifacts
*.db
*.db-journal
*.db-wal
*.db-shm

# Opt-in downloaded extended/conformance EPUB datasets (fixtures.toml-driven;
# never part of a checkout — tests/fixtures/epub/core/ stays tiny)
.build/

# Test & E2E scratch space
e2e/.tmp/
.e2e-tmp/

# E2E failure artifacts (screenshots, logs)
artifacts/

# Coverage
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Web Search outputs
.tavily/
.firecrawl/

# Agent session logs (opencode runtime output)
.opencode/session_logs/

# Realistic user-created test library (real copyrighted books; never commit).
# Tests that use it skip automatically when the path is absent.
tests/fixtures/books/EBooks/*
!tests/fixtures/books/EBooks/manifest.json
!tests/fixtures/books/EBooks/AGENTS.md

# Electron packaging output (electron-builder.yml directories.output)
dist-packages/

# Fetched PDFium shared library for cover extraction (scripts/fetch-pdfium.sh)
sidecar/pdfium/

# Fuzzing (issue #88): libFuzzer build output, runtime corpus, and crash
# artifacts are disposable. The committed seeds live in sidecar/fuzz/seeds/.
sidecar/fuzz/target/
sidecar/fuzz/corpus/
sidecar/fuzz/artifacts/
sidecar/fuzz/coverage/

*.swp
electron/dist/

# Kate editor swap files
*.kate-swp

# Local debugging fixture (issue #67 follow-up) — temporary copy, never commit.
tests/fixtures/ai-engineering.pdf

# Git worktrees (superpowers workflow)
.worktrees/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/

# Beads passive JSONL export (regenerated from the Dolt DB; export.auto=true)
.beads/issues.jsonl

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

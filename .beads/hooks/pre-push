#!/usr/bin/env sh
# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-push' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-push "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-push' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-push'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---

# --- TUXBOOKS PRE-PUSH (outside bd's markers; preserved per `bd hooks install`) ---
# Deterministic line-count gate: every file this push changes must be at most
# tuxbooks_max_lines lines, counted in the blob the push ships, not in the
# working tree. "Changed" is the diff between the pushed tip and the remote
# branch tip, or against the default branch for a new branch. Repository-root
# files are exempt: they hold project meta and config, not code to split.
# Root AGENTS.md is the exception: every push checks it against
# tuxbooks_agents_max_lines, whether or not the push touches it. Binary files
# are skipped: their byte stream reads as thousands of fake lines. So are
# generated lockfiles such as sidecar/Cargo.lock, which nobody hand-splits.
tuxbooks_max_lines=500
tuxbooks_agents_max_lines=145
tuxbooks_report=""
# Prints "  <label> (<n> lines, limit <limit>)" when the blob at $1 runs
# longer than $2 lines, nothing when it fits or cannot be read.
tuxbooks_over_limit() {
  tuxbooks_n=$(git cat-file blob "$1" 2>/dev/null | awk 'END { print NR }')
  if [ -n "$tuxbooks_n" ] && [ "$tuxbooks_n" -gt "$2" ]; then
    printf '  %s (%s lines, limit %s)\n' "$3" "$tuxbooks_n" "$2"
  fi
}
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$local_sha" in
    *[!0]*) ;; # a real object id, SHA-1 or SHA-256
    *) continue ;; # all zeros: this push deletes the remote branch
  esac
  case "$remote_sha" in
    *[!0]*) tuxbooks_base=$remote_sha ;;
    *)
      tuxbooks_default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
      tuxbooks_base=$(git merge-base "$tuxbooks_default" "$local_sha" 2>/dev/null || true)
      if [ -z "$tuxbooks_base" ]; then
        echo >&2 "tuxbooks: pre-push blocked: no merge base with $tuxbooks_default for $local_ref; fetch before pushing"
        exit 1
      fi
      ;;
  esac
  # A changed file name containing a newline would split into two paths
  # below and slip past the count, so refuse the push instead of guessing.
  tuxbooks_n_names=$(git diff --name-only --diff-filter=ACMRT -z "$tuxbooks_base" "$local_sha" | tr -cd '\000' | wc -c)
  tuxbooks_n_lines=$(git diff --name-only --diff-filter=ACMRT -z "$tuxbooks_base" "$local_sha" | tr '\000' '\n' | wc -l)
  if [ $((tuxbooks_n_names)) -ne $((tuxbooks_n_lines)) ]; then
    echo >&2 "tuxbooks: pre-push blocked: a changed file name contains a newline, rename the file first"
    exit 1
  fi
  tuxbooks_violations=""
  tuxbooks_agents_line=$(tuxbooks_over_limit "$local_sha:AGENTS.md" "$tuxbooks_agents_max_lines" "AGENTS.md")
  if [ -n "$tuxbooks_agents_line" ]; then
    tuxbooks_violations="${tuxbooks_agents_line}
"
  fi
  tuxbooks_file_violations=$(git diff --name-only --diff-filter=ACMRT -z "$tuxbooks_base" "$local_sha" |
    tr '\000' '\n' |
    while IFS= read -r tuxbooks_path; do
      [ -n "$tuxbooks_path" ] || continue
      case "$tuxbooks_path" in
        */*) ;; # not the repository root; keep checking
        *) continue ;;  # repository root: project meta and config
      esac
      case "$tuxbooks_path" in
        */pnpm-lock.yaml|*/Cargo.lock) continue ;;
      esac
      # git numstat reports binary files as "-", and their bytes would
      # otherwise count as lines. The literal pathspec keeps glob
      # metacharacters in real file names from matching other files.
      tuxbooks_added=$(git diff --numstat "$tuxbooks_base" "$local_sha" -- ":(literal)$tuxbooks_path" | awk -F'\t' 'NR == 1 { print $1 }')
      case "$tuxbooks_added" in ''|-) continue ;; esac
      tuxbooks_line=$(tuxbooks_over_limit "$local_sha:$tuxbooks_path" "$tuxbooks_max_lines" "$tuxbooks_path")
      if [ -n "$tuxbooks_line" ]; then
        printf '%s\n' "$tuxbooks_line"
      fi
    done)
  if [ -n "$tuxbooks_file_violations" ]; then
    tuxbooks_violations="${tuxbooks_violations}${tuxbooks_file_violations}
"
  fi
  if [ -n "$tuxbooks_violations" ]; then
    tuxbooks_report="${tuxbooks_report}${tuxbooks_violations}"
  fi
done
if [ -n "$tuxbooks_report" ]; then
  echo >&2 "tuxbooks: pre-push blocked: files over their line limit:"
  printf '%s' "$tuxbooks_report" >&2
  exit 1
fi
# --- END TUXBOOKS PRE-PUSH ---
